.DS_Store
.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
.vercel/
coverage.xml
htmlcov/
output/
uploads/
.job_assistant/

# Keep real candidate and application data out of Git.
private/
data/
# Only reviewed public map assets may be published; all other data stays ignored.
!vercel-site/data/
vercel-site/data/*
!vercel-site/data/companies.json
!vercel-site/data/submitted_jobs.json
!vercel-site/data/wikidata_hq.json
!vercel-site/data/world.geojson
!vercel-site/data/logos/
# Existing tracked logos remain versioned; stage only reviewed, referenced new assets.
vercel-site/data/logos/*
venv/

# Local one-off document experiments and generated application outputs.
generated/
scratch/

# Accidental numbered copies; canonical runtime files remain tracked.
vercel-site/* [0-9].mjs
vercel-site/* [0-9].html
vercel-site/vendor/* [0-9].js
vercel-site/vendor/* [0-9].css
