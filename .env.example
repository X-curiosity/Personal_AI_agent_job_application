# Optional Tau chat agent and interview transcription
OPENAI_API_KEY=
MODEL_NAME=

# Optional official-platform credentials. Provide them through your shell or the
# Streamlit one-time input; never commit real values.
LINKEDIN_ACCESS_TOKEN=
X_BEARER_TOKEN=

# Optional read-only reply integrations for the role-first application portal.
# Provision OAuth/bot tokens outside this app; no built-in login/refresh exists.
# Bind a conversation and exact sender and grant read consent in the UI.
GMAIL_ACCESS_TOKEN=
SLACK_BOT_TOKEN=

# Not used by default. Optional Jev decision model for AMBIGUOUS skill pairs only
# (opt-in checkbox on Overview; canonical scores never depend on it).
# Only the two skill labels and a fixed question are sent. See docs/JEV_NOTES.md.
# JEV_API_URL is required and must come from the official documentation, e.g.
# https://<official-host>/v1/decide
JEV_API_KEY=
JEV_API_URL=
